# ============================================================
# Climate Anomaly Detection & Forecasting Engine
# Environment Configuration
# ============================================================

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=climate
POSTGRES_PASSWORD=climate_secret
POSTGRES_DB=climate_db
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Spark ---
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# --- HDFS ---
HDFS_NAMENODE_HOST=namenode
HDFS_NAMENODE_PORT=9000
HDFS_DATA_DIR=/climate-data

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-api-key-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- NOAA CDO API (for data download) ---
NOAA_API_TOKEN=your-noaa-token-here

# --- Copernicus CDS API (for ERA5 download) ---
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=your-cds-uid:your-cds-api-key
